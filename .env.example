# Copy to .env.local (git-ignored) and fill in.
# Real environment variables always win over anything in these files.

# Vercel AI Gateway. Absent or empty means the game runs fully deterministically.
AI_GATEWAY_API_KEY=

# Force the deterministic path even when a key is present.
# NO_AI=1

# A word or a number. Same seed, same world, forever.
# WORLD_SEED=hollowmoor
# WORLD_NAME=default

# All model selection is per call type and overridable.
# MODEL_DIRECTOR=google/gemini-2.5-flash-lite
# MODEL_DIALOGUE=google/gemini-2.5-flash
# MODEL_SUMMARY=google/gemini-2.5-flash-lite
# MODEL_BIBLE=google/gemini-2.5-flash

# The TUI owns stdout, so logs go to a file. Token and cost accounting lands here.
# LOG_LEVEL=debug
# LOG_FILE=log.txt

# AUTO_ADVENTURE_HOME=~/.auto-adventure

# Frames are emitted as one synchronized terminal update (DEC mode 2026) so the
# screen never shows a half-painted frame. Set this if your terminal does not
# understand the escape and prints it instead of honouring it.
# NO_SYNC_OUTPUT=1
