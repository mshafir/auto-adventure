# Copy to .env.local (git-ignored) and fill in.
# Real environment variables always win over anything in these files.

# Vercel AI Gateway. Absent or empty means the game runs fully deterministically.
#
# You do not have to set this at all: Options on the title screen takes a key and
# keeps it in ~/.auto-adventure/settings.json, readable only by you. A key here
# always wins over that one, which is what keeps a scripted run predictable.
AI_GATEWAY_API_KEY=

# Force the deterministic path even when a key is present.
# NO_AI=1

# A word or a number. Same seed, same world, forever.
# WORLD_SEED=hollowmoor
# WORLD_NAME=default

# Which pair of models writes a world. Normally chosen in the launcher — on the
# Options page, or on the page that configures a world before it is written — and
# remembered in ~/.auto-adventure/settings.json. Set it here to pin one.
#
# glm · deepseek · gpt-5-mini · gemini-2.5 (the default) · gemini-3 ·
# claude-haiku · claude-sonnet — see src/ai/catalogue.ts for what each costs.
# MODEL_SET=gemini-2.5

# And per call type, which beats everything above. The cheap half of the chosen
# pair does the high-volume structured work; the dear half writes what you read.
# MODEL_DIRECTOR=google/gemini-2.5-flash-lite
# MODEL_DIALOGUE=google/gemini-2.5-flash
# MODEL_SUMMARY=google/gemini-2.5-flash-lite
# MODEL_BIBLE=google/gemini-2.5-flash

# The TUI owns stdout, so logs go to a file. Token and cost accounting lands here.
# LOG_LEVEL=debug
# LOG_FILE=log.txt

# AUTO_ADVENTURE_HOME=~/.auto-adventure

# Frames are emitted as one synchronized terminal update (DEC mode 2026) so the
# screen never shows a half-painted frame. Set this if your terminal does not
# understand the escape and prints it instead of honouring it.
# NO_SYNC_OUTPUT=1
